# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-me

# AWS / DynamoDB (prefixed with APP_ for Netlify compatibility)
APP_AWS_REGION=us-east-1
APP_SUBSCRIPTIONS_TABLE=Subscriptions
APP_AUTH_DYNAMODB_TABLE=AuthUsers

# If using long-lived keys locally (don't commit real values)
APP_AWS_ACCESS_KEY_ID=replace-me
APP_AWS_SECRET_ACCESS_KEY=replace-me

# Optional: KMS encryption for sensitive data
# APP_KMS_KEY_ID=replace-me
